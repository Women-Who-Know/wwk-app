# Copy this to .env.local for development
# Set all of these as Environment Variables in Vercel dashboard before deploying

# Anthropic
ANTHROPIC_API_KEY=your_anthropic_key_here

# Stripe (use test keys until ready to go live)
STRIPE_SECRET_KEY=sk_test_REPLACE_WITH_YOUR_STRIPE_SECRET_KEY
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_REPLACE_WITH_YOUR_STRIPE_PUBLISHABLE_KEY

# Resend
RESEND_API_KEY=REPLACE_WITH_YOUR_RESEND_API_KEY

# App URL (your Vercel deployment URL)
NEXT_PUBLIC_APP_URL=https://wwk-assessment.vercel.app
